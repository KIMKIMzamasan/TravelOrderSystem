<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TravelOrderSystem"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" 
        Width="800" 
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent">
    <Grid>
        <Border
            Background="MidnightBlue"
            CornerRadius="20"
            >
            <Label Content="Travel Order System" 
                   Margin="30,191,303,191"
                   FontSize="46"
                   FontFamily="Century Gothic"
                   FontWeight="Bold"
                   Foreground="White"/>
        </Border>

        <Border Margin="520,0,0,0"
            Background="White"
                CornerRadius="0, 20, 20, 0">
            <Button Margin="0,315,0,63"
                    Background="MidnightBlue"
                    BorderBrush="MidnightBlue"
                    Content="Login"
                    FontFamily="Century Gothic"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White" Click="Button_Click"></Button>

        </Border>
        <TextBox TextWrapping="Wrap" 
                 Text="Enter Username" 
                 Margin="546,150,26,266"
                 FontFamily="Century Gothic"
                 FontSize="18"
                 />
        <Label Content="Username" 
               Margin="546,109,113,0" 
               Height="36" 
               VerticalAlignment="Top"
               FontFamily="Century Gothic"
               FontSize="24"
               FontWeight="Bold"
               />
        <TextBox TextWrapping="Wrap" 
            Text="Enter Password" 
            Margin="546,248,26,168"
            FontFamily="Century Gothic"
            FontSize="18"
                 />
        <Label Content="Password" 
            Margin="546,0,113,0" 
            Height="36" 
            VerticalAlignment="Center"
            FontFamily="Century Gothic"
            FontSize="24"
            FontWeight="Bold"
               />
    </Grid>
</Window>
